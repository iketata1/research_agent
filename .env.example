# Copiez ce fichier vers .env et renseignez vos secrets.
# Ne versionnez jamais le fichier .env (il est ignore par .gitignore).
# Ces variables sont chargees et typees par src/research_agent/config.py (Secrets).

# --- LLM ---
# Cle API du fournisseur LLM (OpenAI / Anthropic / Mistral)
LLM_API_KEY=

# --- OpenAlex ---
# Email de contact pour le "polite pool" d'OpenAlex (recommande, non secret)
OPENALEX_MAILTO=

# --- Telegram (si livraison via Telegram) ---
# Token du bot (secret, obtenu aupres de @BotFather)
TELEGRAM_BOT_TOKEN=
# Identifiant du chat destinataire (peut aussi etre place dans config.yaml)
TELEGRAM_CHAT_ID=
# Chat dedie aux alertes critiques (optionnel ; a defaut, le chat ci-dessus)
TELEGRAM_ALERT_CHAT_ID=

# --- SMTP (si livraison par email) ---
SMTP_USER=
SMTP_PASSWORD=
