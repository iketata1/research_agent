# =============================================================================
# Research Intelligence Agent — fichier de secrets (.env)
# =============================================================================
# Copiez ce fichier vers .env et renseignez vos valeurs :   cp .env.example .env
# NE VERSIONNEZ JAMAIS .env (il est ignore par .gitignore).
#
# Ce fichier ne contient QUE des secrets et identifiants. Les parametres non
# secrets (chemin de la base SQLite, seuils, mots-cles, sources, canal de
# livraison) se configurent dans config/config.yaml.
#
# Variables chargees et typees par src/research_agent/config.py (classe Secrets).
# =============================================================================

# --- LLM (obligatoire pour le filtrage/scoring/resume) -----------------------
# Cle API du fournisseur LLM. Compatible OpenAI, Mistral, etc.
# - OpenAI  : https://platform.openai.com/api-keys      (ex. sk-...)
# - Mistral : https://console.mistral.ai/api-keys
# Le modele et l'URL de base se configurent dans config.yaml (section llm).
LLM_API_KEY=

# --- OpenAlex (recommande, non secret) ---------------------------------------
# Email de contact pour le "polite pool" d'OpenAlex : quotas plus stables.
OPENALEX_MAILTO=

# --- Telegram (obligatoire pour la livraison Telegram) -----------------------
# Token du bot, obtenu via @BotFather (commande /newbot). Secret.
TELEGRAM_BOT_TOKEN=
# Identifiant du chat destinataire du rapport hebdomadaire.
# Pour l'obtenir : ecrire un message au bot, puis consulter
# https://api.telegram.org/bot<TOKEN>/getUpdates  et lire chat.id
TELEGRAM_CHAT_ID=
# (Optionnel) Chat dedie aux alertes critiques (score >= 90).
# A defaut, les alertes vont sur TELEGRAM_CHAT_ID.
TELEGRAM_ALERT_CHAT_ID=

# --- SMTP (optionnel, uniquement si livraison par email) ---------------------
SMTP_USER=
SMTP_PASSWORD=
